{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "**/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "examples/**/*.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    }
  }
}
