{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "**/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "packages/rules": {
      "ignoreDependencies": [
        "@types/eslint"
      ],
      "ignoreFiles": [
        "test/fixtures/**"
      ]
    },
    "packages/utils": {
      "entry": [
        "examples/**/*.ts"
      ]
    }
  }
}
